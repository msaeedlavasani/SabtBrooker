# ====================================================================
# SabtBrooker — پیکربندی محیط تولید (Production)
# دستور: cp .env.production.example .env.production و مقادیر را تنظیم کنید
# ====================================================================

# ── سرور ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# ── دیتابیس (PostgreSQL + PostGIS) ───────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=sabtbrooker
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=sabtbrooker
DB_SSLMODE=disable

# ── Redis ────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── NATS ─────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── JWT ──────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=sabtbrooker

# ── OTP ──────────────────────────────────────────────────
OTP_LENGTH=5
OTP_TTL=2m
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW=10m

# ── MinIO (ذخیره‌سازی فایل) ──────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_KEY
MINIO_BUCKET=sabtbrooker
MINIO_USE_SSL=false

# ── درگاه پیامک (SMS Gateway) ────────────────────────────
# تأمین‌کننده: kavenegar | melipayamak | farazsms
SMS_PROVIDER=kavenegar
SMS_API_KEY=REPLACE_WITH_YOUR_SMS_API_KEY
SMS_SENDER_NUMBER=REPLACE_WITH_YOUR_SENDER_NUMBER

# ── یکپارچه‌سازی با سازمان ثبت ────────────────────────────
ORG_API_BASE_URL=REPLACE_WITH_ORG_API_URL
ORG_API_KEY=REPLACE_WITH_ORG_API_KEY

# ── درگاه پرداخت (زرین‌پال) ──────────────────────────────
PSP_MERCHANT_ID=REPLACE_WITH_ZARINPAL_MERCHANT_ID

# ── رمزنگاری (AES-256) ──────────────────────────────────
# تولید کلید: openssl rand -hex 32
SECURITY_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_64_CHARS

# ── حالت توسعه (بدون SMS) ──────────────────────────────
# true = نمایش OTP در پاسخ API (نیاز به پنل SMS ندارد)
# false = فقط SMS (برای Production واقعی)
DEV_MODE=true

# ── دامنه فرانت‌اِند (برای CORS) ──────────────────────────
FRONTEND_URL=https://YOUR_DOMAIN.com
