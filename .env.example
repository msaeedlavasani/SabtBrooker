# SabtBrooker Backend Configuration
# Copy this file to .env and adjust values

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=sabtbrooker
DB_PASSWORD=sabtbrooker
DB_NAME=sabtbrooker
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222
NATS_STREAM=sabtbrooker
NATS_MAX_RECONN=10

# JWT
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=sabtbrooker

# OTP
OTP_LENGTH=5
OTP_TTL=2m
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW=10m

# Security
SECURITY_MAX_FAILED_LOGIN=5
SECURITY_LOCK_DURATION=30m
SECURITY_BCRYPT_COST=12
SECURITY_ENCRYPTION_KEY=

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sabtbrooker
MINIO_USE_SSL=false

# SMS Gateway (to be configured)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_NUMBER=

# Organization Integration (to be configured)
ORG_API_BASE_URL=
ORG_API_KEY=
ORG_API_TIMEOUT=30s

# Payment Gateway (to be configured)
PSP_MERCHANT_ID=
PSP_TERMINAL_ID=
PSP_CALLBACK_URL=
